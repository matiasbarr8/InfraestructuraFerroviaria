import vagones.*
import locomotoras.*

describe "Tests etapa 2" {
  const vagonDePasajeros = new VagonDePasajeros(largo=10,ancho=4, estaOrdenado=true,tieneBaño=true)
  const vagonDePasajeros2 =  new VagonDePasajeros(largo=7,ancho=2)
  const vagonDeCarga = new VagonDeCarga(cargaMaxima=6800, cantidadMaderasSueltas=5)
  const vagonDormitorio = new VagonDeDormitorio(compartimientos = 8, camasEnCompartimientos=3)
  const formacionVagones = new FormacionLocomotoras(vagones=[vagonDePasajeros,vagonDePasajeros2,vagonDeCarga,vagonDormitorio])
  const locomotora1 = new Locomotora(peso=3000,pesoAArrastrar=20000,velMaxima=100)
  const locomotora2 = new Locomotora(peso=5000,pesoAArrastrar=22000,velMaxima=150)

  test "Contando sólo los vagones, el peso máximo es 29800" {
    assert.equals(29800, formacionVagones.pesoMaximoDeLaFormacion())
  }
  test "Si a la formación le agregamos la locomotora 1, entonces, es eficiente, no puede moverse, y le faltan 12800 kg de empuje." {
    formacionVagones.agregarLocomotora(locomotora1)
    assert.that(formacionVagones.esEficiente())
    assert.notThat(formacionVagones.puedeMoverse())
    assert.equals(12800, formacionVagones.kilosDeEmpujeParaMoverse())
  }
  test "Si a la misma formación le agregamos también la locomotora 2, entonces no es eficiente, sí puede moverse, y le faltan 0 kilos de empuje." {
    formacionVagones.agregarLocomotora(locomotora1)
    formacionVagones.agregarLocomotora(locomotora2)
    assert.notThat(formacionVagones.esEficiente())
    assert.that(formacionVagones.puedeMoverse())
    assert.equals(0, formacionVagones.kilosDeEmpujeParaMoverse())
  }

}